    private static void setVehicleCapacity() {
        System.out.print("Enter vehicle ID: ");
        String id = scanner.nextLine().trim();
        Vehicle v = findVehicleId(id);
        if (v == null) {
            System.out.println(ANSI_RED + "Vehicle not found." + ANSI_RESET);
